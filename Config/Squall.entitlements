<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The folder the app and its widgets share. Must match SquallAppGroup in Info.plist. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(SQUALL_BUNDLE_ID)</string>
	</array>
	<!-- The app's own group stays first so the pairing token stays private; .shared is for the widgets. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(SQUALL_BUNDLE_ID)</string>
		<string>$(AppIdentifierPrefix)$(SQUALL_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
